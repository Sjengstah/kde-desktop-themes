#!/usr/bin/env bash
# kde-audio-overlay: open or close the audio overlay
#
# What it does:
#   A toggle, meant to sit under a keyboard shortcut.
#   - Overlay already open? Then it closes it and stops.
#   - Otherwise it starts ~/.local/share/kde-audio-overlay/Overlay.qml with the Qt 6
#     QML runtime, using KDE's look for the buttons and sliders. It tries qml6,
#     qml-qt6 and the usual Qt paths, because the name differs per distro.
#   - No QML runtime found: shows a desktop notification and exits with code 1.
#   It changes nothing on the system.
#
# Installed by install.sh as ~/.local/bin/kde-audio-overlay.
# Setting:  KDE_AUDIO_OVERLAY_DIR=/other/folder makes it look for Overlay.qml there.
set -euo pipefail

dir="${KDE_AUDIO_OVERLAY_DIR:-$HOME/.local/share/kde-audio-overlay}"
overlay="$dir/Overlay.qml"

if pkill -f -- "$overlay" 2>/dev/null; then
    exit 0
fi

# Use the KDE look for the controls.
export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-org.kde.desktop}"

# The QML runtime has a different name per distribution.
for runtime in qml6 qml-qt6 /usr/lib64/qt6/bin/qml /usr/lib/qt6/bin/qml; do
    if command -v "$runtime" >/dev/null 2>&1; then
        exec "$runtime" "$overlay" >/dev/null 2>&1
    fi
done

notify-send -a "Audio Overlay" "Audio Overlay" "Qt 6 QML runtime not found. See the README for the package to install." 2>/dev/null \
    || echo "Qt 6 QML runtime not found. See the README." >&2
exit 1
