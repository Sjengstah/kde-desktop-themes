#!/usr/bin/env bash
# maastricht-audio: open or close the MAASTRICHT audio overlay
#
# What it does:
#   A toggle, meant to sit under a keyboard shortcut.
#   - Overlay already open? Then it closes it and stops.
#   - Otherwise it starts ~/.local/share/maastricht-audio/Overlay.qml with the Qt 6 QML runtime.
#     It tries qml6, qml-qt6 and the usual Qt paths, because the name differs per distro.
#   - No QML runtime found: shows a desktop notification and exits with code 1.
#   It changes nothing on the system.
#
# Installed by install.sh as ~/.local/bin/maastricht-audio.
# Setting:  MAASTRICHT_AUDIO_DIR=/other/folder makes it look for Overlay.qml there instead.
set -euo pipefail

dir="${MAASTRICHT_AUDIO_DIR:-$HOME/.local/share/maastricht-audio}"
overlay="$dir/Overlay.qml"

if pkill -f -- "$overlay" 2>/dev/null; then
    exit 0
fi

# The QML runtime has a different name per distribution.
for runtime in qml6 qml-qt6 /usr/lib64/qt6/bin/qml /usr/lib/qt6/bin/qml; do
    if command -v "$runtime" >/dev/null 2>&1; then
        exec "$runtime" "$overlay" >/dev/null 2>&1
    fi
done

notify-send -a "MAASTRICHT Audio" "MAASTRICHT Audio" "Qt 6 QML runtime not found. See the README for the package to install." 2>/dev/null \
    || echo "Qt 6 QML runtime not found. See the README." >&2
exit 1
