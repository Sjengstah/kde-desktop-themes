// MVV fastfetch config (MVV Maastricht–inspired look). Palette matches the MVV theme.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "38;2;210;0;31",
      "2": "38;2;232;180;184",
      "3": "38;2;255;210;0",
      "4": "38;2;255;246;240"
    },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 28 },
    "color": { "keys": "38;2;210;0;31", "output": "38;2;255;246;240" }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;210;0;31}▐██████{#38;2;122;16;32}██{#38;2;232;180;184}████ {#1;38;2;210;0;31}MVV · MAASTRICHT {#38;2;232;180;184}████{#38;2;210;0;31}███████▌"
    },
    {
      "type": "command",
      "key": "{#38;2;246;218;219}▐█ MINUTE (DAY)",
      "text": "echo $(( ($(date +%-H) * 60 + $(date +%-M)) * 90 / 1440 ))"
    },
    {
      "type": "title",
      "key": "{#38;2;246;218;219}▐█ PLAYER (USER)",
      "format": "{user-name}@{host-name}"
    },
    "break",
    { "type": "custom", "format": "{#38;2;122;16;32}▐███ {#1;38;2;122;16;32}KIT {#0;38;2;122;16;32}███████████████████████▌" },
    { "type": "os",       "key": "▐█ SHIRT (OS)" },
    { "type": "kernel",   "key": "▐█ BOOTS (KERNEL)" },
    { "type": "uptime",   "key": "▐█ MATCH TIME (UPTIME)" },
    { "type": "packages", "key": "▐█ SQUAD (PACKAGES)" },
    { "type": "shell",    "key": "▐█ ARMBAND (SHELL)" },
    { "type": "de",       "key": "▐█ DE GEUSSELT (DESKTOP)" },
    { "type": "terminal", "key": "▐█ SCOREBOARD (TERMINAL)" },
    "break",
    { "type": "custom", "format": "{#38;2;255;210;0}▐███ {#1;38;2;255;210;0}SQUAD FITNESS {#0;38;2;255;210;0}██████████████████████▌" },
    { "type": "cpu",      "key": "▐█ MIDFIELD (CPU)", "temp": true },
    { "type": "gpu",      "key": "▐█ ATTACK (GPU)" },
    { "type": "memory",   "key": "▐█ STAMINA (MEMORY)" },
    { "type": "swap",     "key": "▐█ BENCH (SWAP)" },
    { "type": "disk",     "key": "▐█ KIT ROOM (STORAGE) {mountpoint}", "folders": "/" },
    { "type": "display",  "key": "▐█ BIG SCREEN (DISPLAY)" },
    { "type": "localip",  "key": "▐█ SUPPORTERS (NETWORK)" },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;210;0;31}▐████{#38;2;255;246;240}████{#38;2;122;16;32}████{#38;2;232;180;184}████{#38;2;246;218;219}████{#38;2;255;210;0}████{#38;2;160;0;24}████{#38;2;210;0;31}████▌"
    }
  ]
}
